    "/regions/stats": {
      "get": {
        "summary": "Statistiques des regions",
        "responses": {
          "200": {
            "description": "Couverture des dernières populations vérifiées : verified, matchingCurrentBoundaries, total, referenceYear et complete. totalPopulation et le classement restent null tant que la couverture, l’année ou le périmètre actuel sont incompatibles."
          }
        }
      }
    },
    "/prefectures/stats": {
      "get": {
        "summary": "Statistiques des prefectures",
        "responses": {
          "200": {
            "description": "Couverture des dernières populations vérifiées : verified, matchingCurrentBoundaries, total, referenceYear et complete. totalPopulation et le classement restent null tant que la couverture, l’année ou le périmètre actuel sont incompatibles."
          }
        }
      }
    },
    "/regions/{name}/prefectures": {
      "get": {
        "summary": "Préfectures d’une région",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "includeHistory",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "true pour ajouter populationHistory ; false ou absent pour retourner uniquement la dernière population vérifiée."
          }
        ],
        "responses": {
          "200": {
            "description": "Préfectures actives rattachées à la région. Les rattachements pending sont exclus ; leur ancien parent reste consultable dans la liste générale.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Prefecture"
                  }
                }
              }
            }
          },
