          }
        }
      }
    },
    "/populations/rgph4-2025": {
      "get": {
        "summary": "Populations officielles du RGPH-4, référence territoriale 2025",
        "description": "Résultats préliminaires : 8 régions au périmètre du recensement, 33 préfectures, 13 communes de Conakry et total national. Ce référentiel ne représente pas les périmètres créés en août 2026.",
        "responses": {
          "200": {
            "description": "Référentiel sourcé, pages du rapport INS, contrôles et limites"
          }
        }
      }
    }
