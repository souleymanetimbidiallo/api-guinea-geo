  "components": {
    "schemas": {
      "Region": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "zone": {
            "type": "string"
          },
          "population": {
            "type": "integer",
            "nullable": true,
            "minimum": 0,
            "description": "Dernière population vérifiée et datée. null en l’absence d’observation fiable ; aucune valeur héritée non vérifiée n’est utilisée."
          },
          "area": {
            "type": "number"
          },
          "administrativeStatus": {
            "type": "string",
            "enum": [
              "active",
              "historical"
            ],
            "description": "Les listes publiques excluent les anciens enregistrements historisés."
          },
          "administrativeType": {
            "type": "string",
            "description": "Conakry est représentée comme zone spéciale."
          },
          "effectiveFrom": {
            "type": "string",
            "format": "date",
            "description": "Date de création documentée ; absente si non vérifiée."
          },
          "reviewedAt": {
            "type": "string",
            "format": "date"
          },
          "parentStatus": {
            "type": "string",
            "enum": [
              "verified",
              "legacy-unverified",
              "pending"
            ],
            "description": "pending : la relation conservée est un ancien rattachement à confirmer."
          },
          "metricsStatus": {
            "type": "string",
            "enum": [
              "verified",
              "legacy-unverified",
              "unavailable"
            ],
            "description": "Statut des valeurs héritées stockées, notamment la superficie. Le statut de population renvoyé est décrit séparément par populationStatus."
          },
          "notes": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "publishedAt": {
                  "type": "string",
                  "format": "date"
                }
              }
            }
          },
          "populationReferenceYear": {
            "type": "integer",
            "nullable": true,
            "description": "Année de référence de la population sélectionnée, pas l’année de publication."
          },
          "populationStatus": {
            "type": "string",
            "enum": [
              "preliminary",
              "final",
              "unavailable"
            ]
          },
          "populationGeographicReference": {
            "type": "string",
            "nullable": true,
            "description": "Périmètre de référence de la population ; peut précéder le découpage actuel."
          },
          "populationBoundaryCompatibility": {
            "type": "string",
            "nullable": true,
            "enum": [
              "not-assessed",
              "verified",
              null
            ]
          },
          "populationSource": {
            "type": "object",
            "nullable": true,
            "properties": {
              "publisher": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "publishedAt": {
                "type": "string",
                "format": "date"
              },
              "sha256": {
                "type": "string"
              },
              "pdfPage": {
                "type": "integer",
                "nullable": true
              },
              "printedPage": {
                "type": "integer",
                "nullable": true
              }
            }
          },
          "populationHistory": {
            "type": "object",
            "description": "Présent uniquement avec includeHistory=true. Les anciennes valeurs ne remplacent jamais le champ population principal.",
            "properties": {
              "legacy": {
                "type": "object",
                "nullable": true,
                "properties": {
                  "population": {
                    "type": "integer"
                  },
                  "referenceYear": {
                    "type": "integer",
                    "nullable": true
                  },
                  "status": {
                    "type": "string"
                  }
                }
              },
              "observations": {
                "type": "array",
                "description": "Observations datées distinctes du champ population hérité. Une observation RGPH-4 2025 ne valide pas une population au périmètre administratif de 2026.",
                "items": {
                  "type": "object",
                  "properties": {
                    "referenceId": {
                      "type": "string"
                    },
                    "year": {
                      "type": "integer",
                      "example": 2025
                    },
                    "publicationStatus": {
                      "type": "string",
                      "enum": [
                        "preliminary",
                        "final"
                      ]
                    },
                    "population": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "male": {
                      "type": "integer"
                    },
                    "female": {
                      "type": "integer"
                    },
                    "geographicReference": {
                      "type": "string"
                    },
                    "boundaryCompatibility": {
                      "type": "string",
                      "enum": [
                        "not-assessed",
                        "verified"
                      ]
                    },
                    "regionAtCensus": {
                      "type": "string"
                    },
                    "sourcePdfPage": {
                      "type": "integer"
                    },
                    "sourcePrintedPage": {
                      "type": "integer"
                    },
                    "reviewedAt": {
                      "type": "string",
                      "format": "date"
                    },
                    "source": {
                      "type": "object",
                      "properties": {
                        "publisher": {
                          "type": "string"
                        },
                        "title": {
                          "type": "string"
                        },
                        "url": {
                          "type": "string",
                          "format": "uri"
                        },
                        "publishedAt": {
                          "type": "string",
                          "format": "date"
                        },
                        "sha256": {
                          "type": "string"
                        }
                      }
                    },
                    "verificationStatus": {
                      "type": "string",
                      "enum": [
                        "verified",
                        "unverified"
                      ],
                      "description": "Requis pour sélectionner une observation d’un futur référentiel non enregistré."
                    }
                  }
                }
              }
            }
          }
        }
      },
      "Prefecture": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "population": {
            "type": "integer",
            "nullable": true,
