{
  "openapi": "3.0.0",
  "info": {
    "title": "API Guinée Geo",
    "version": "1.0.0",
    "description": "API des subdivisions administratives de Guinée. population renvoie la dernière observation vérifiée, avec son année, sa source et son périmètre. Les anciennes valeurs sont masquées par défaut et disponibles via includeHistory=true. Les créations de 2026 et les limites de couverture sont documentées."
  },
  "servers": [
    {
      "url": "/",
      "description": "Serveur courant"
    },
    {
      "url": "https://api-guinea-geo.vercel.app"
    }
  ],
  "paths": {
    "/regions": {
      "get": {
        "summary": "Liste des régions",
        "responses": {
          "200": {
            "description": "Retourne toutes les régions.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Region"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Paramètre invalide"
          }
        },
        "parameters": [
          {
            "name": "includeHistory",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "true pour ajouter populationHistory ; false ou absent pour retourner uniquement la dernière population vérifiée."
          }
        ]
      }
    },
    "/regions/search": {
      "get": {
        "summary": "Chercher une région par nom",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Nom de la région"
          },
          {
            "name": "includeHistory",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "true pour ajouter populationHistory ; false ou absent pour retourner uniquement la dernière population vérifiée."
          }
        ],
        "responses": {
          "200": {
            "description": "Détails de la région",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Region"
                }
              }
            }
          },
          "404": {
            "description": "Région non trouvée"
          },
          "400": {
            "description": "Paramètre name manquant ou invalide"
          }
        }
      }
    },
