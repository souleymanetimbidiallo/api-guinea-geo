            "description": "Région ou préfectures introuvables"
          },
          "400": {
            "description": "Paramètre invalide"
          }
        }
      }
    },
    "/data-sources": {
      "get": {
        "summary": "Sources vérifiées et limites de la mise à jour administrative",
        "responses": {
